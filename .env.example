GRYT_HOST=
GRYT_NICKNAME=AI Chat
## By default, reread the entire Gryt thread on every reply without a local history cache.
## Set to true to cache history on disk; disabling it also removes existing local history caches.
HISTORY_CACHE_ENABLED=false
## Only applies when the cache is enabled. Lifetime in hours (168 = 7 days), not renewed by replies.
HISTORY_TTL_HOURS=168

## Set ASSISTANT_MODEL to override the provider's default on the next reply in any conversation.
## OpenRouter uses free models by default; set ASSISTANT_MODEL to another model if needed.

## Enable one provider block at a time, including its model setting.
## To use Codex with your ChatGPT account:
## 1. Set GRYT_HOST above, then build and start the bot:
##    docker compose up -d --build
## 2. Start the login flow inside the running container:
##    docker exec -it gryt-ai-chat-bot codex login --device-auth
##    Open the URL shown, enter the code, and sign in to your ChatGPT account.
## 3. Confirm that login succeeded:
##    docker exec -it gryt-ai-chat-bot codex login status
## The login is stored in the /data/codex volume directory and survives container recreation.
ASSISTANT_PROVIDER=codex
ASSISTANT_MODEL=gpt-6-luna

## For ASSISTANT_PROVIDER=openai, also set OPENAI_API_KEY.
# ASSISTANT_PROVIDER=openai
# ASSISTANT_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=

## For ASSISTANT_PROVIDER=openrouter, also set OPENROUTER_API_KEY.
# ASSISTANT_PROVIDER=openrouter
# ASSISTANT_MODEL=openrouter/free
# OPENROUTER_API_KEY=
